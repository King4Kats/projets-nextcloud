<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>temonia_pilotage</id>
    <name>Projets (socle)</name>
    <summary>Socle de l'appli Projets : données, droits et historique des projets, tâches et heures</summary>
    <description><![CDATA[
Socle sans écran de l'appli « Projets » (temonia_saisie) : projets → activités → tâches,
heures prévues et pointées, droits par groupes, historique et flux Activité.
À installer AVANT temonia_saisie.
    ]]></description>
    <version>0.13.0</version>
    <licence>agpl</licence>
    <author>Flavien Auvray</author>
    <namespace>TemoniaPilotage</namespace>
    <category>organization</category>
    <bugs>https://github.com/King4Kats/projets-nextcloud/issues</bugs>
    <dependencies>
        <nextcloud min-version="29" max-version="34"/>
    </dependencies>
    <!-- Flux « Activité » Nextcloud : les événements marquants (statut, blocage,
         création…) apparaissent dans l'onglet Activité des membres du projet. -->
    <activity>
        <settings>
            <setting>OCA\TemoniaPilotage\Activity\Setting</setting>
        </settings>
        <providers>
            <provider>OCA\TemoniaPilotage\Activity\Provider</provider>
        </providers>
    </activity>
    <!-- Navigation retirée : Pilotage est désormais le socle de données de
         l'app unique « Projets » (la gestion admin y est intégrée, visible
         seulement pour la direction). Plus d'icône d'app séparée. -->
</info>
